<div class="rh-root">
  <div class="rh-toolbar">
    <button type="button" data-action="zoomOut" data-tooltip="{{labels.zoomOut}}" aria-label="{{labels.zoomOut}}"><i class="fa-solid fa-magnifying-glass-minus"></i></button>
    <button type="button" data-action="zoomIn" data-tooltip="{{labels.zoomIn}}" aria-label="{{labels.zoomIn}}"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
    <button type="button" data-action="fit" data-tooltip="{{labels.fit}}" aria-label="{{labels.fit}}"><i class="fa-solid fa-expand"></i></button>
    <span class="rh-hint">{{labels.hint}}</span>
    {{#if isGM}}
    <button type="button" class="rh-share" data-action="share"><i class="fa-solid fa-paper-plane"></i> {{labels.share}}</button>
    {{/if}}
  </div>
  <div class="rh-body">
    {{#if showTabs}}
    <nav class="rh-tabs">
      {{#each entries}}
      <button type="button" class="rh-tab {{#if active}}active{{/if}}" data-action="selectTab" data-index="{{index}}" data-tooltip="{{titre}}">
        <span class="rh-tab-num">{{label}}</span>
        {{#if titre}}<span class="rh-tab-title">{{titre}}</span>{{/if}}
        {{#if isNew}}<span class="rh-new">{{../labels.new}}</span>{{/if}}
      </button>
      {{/each}}
    </nav>
    {{/if}}
    <div class="rh-scroll">
      {{#if src}}
      <img class="rh-img" src="{{src}}" alt="Résumé hebdomadaire" draggable="false">
      {{else}}
      <p class="rh-none">{{labels.none}}</p>
      {{/if}}
    </div>
  </div>
</div>
